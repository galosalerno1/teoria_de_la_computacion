<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<structure>
	<type>turing</type>
	<automaton>
		<!-- L = { w # w^R : w en {0,1}* }  (lenguaje independiente del contexto, no regular) -->
		<state id="0" name="q0">
			<x>80.0</x>
			<y>250.0</y>
			<initial/>
		</state>
		<state id="1" name="q1">
			<x>320.0</x>
			<y>100.0</y>
		</state>
		<state id="2" name="q1p">
			<x>560.0</x>
			<y>100.0</y>
		</state>
		<state id="3" name="q2">
			<x>320.0</x>
			<y>400.0</y>
		</state>
		<state id="4" name="q2p">
			<x>560.0</x>
			<y>400.0</y>
		</state>
		<state id="5" name="qret">
			<x>320.0</x>
			<y>250.0</y>
		</state>
		<state id="6" name="qcheck">
			<x>80.0</x>
			<y>50.0</y>
		</state>
		<state id="7" name="qaccept">
			<x>80.0</x>
			<y>450.0</y>
			<final/>
		</state>

		<!-- desde q0: elegir simbolo de la izquierda a marcar -->
		<transition><from>0</from><to>1</to><read>0</read><write>X</write><move>R</move></transition>
		<transition><from>0</from><to>3</to><read>1</read><write>X</write><move>R</move></transition>
		<transition><from>0</from><to>0</to><read>X</read><write>X</write><move>R</move></transition>
		<transition><from>0</from><to>6</to><read>#</read><write>#</write><move>R</move></transition>

		<!-- q1: viajar hasta el final real de la cinta buscando el ultimo simbolo, se espera 0 -->
		<transition><from>1</from><to>1</to><read>0</read><write>0</write><move>R</move></transition>
		<transition><from>1</from><to>1</to><read>1</read><write>1</write><move>R</move></transition>
		<transition><from>1</from><to>1</to><read>#</read><write>#</write><move>R</move></transition>
		<transition><from>1</from><to>1</to><read>X</read><write>X</write><move>R</move></transition>
		<transition><from>1</from><to>2</to><read></read><write></write><move>L</move></transition>

		<!-- q1p: comparar el ultimo simbolo, debe ser 0 -->
		<transition><from>2</from><to>5</to><read>0</read><write>X</write><move>L</move></transition>

		<!-- q2: viajar hasta el final real de la cinta, se espera 1 -->
		<transition><from>3</from><to>3</to><read>0</read><write>0</write><move>R</move></transition>
		<transition><from>3</from><to>3</to><read>1</read><write>1</write><move>R</move></transition>
		<transition><from>3</from><to>3</to><read>#</read><write>#</write><move>R</move></transition>
		<transition><from>3</from><to>3</to><read>X</read><write>X</write><move>R</move></transition>
		<transition><from>3</from><to>4</to><read></read><write></write><move>L</move></transition>

		<!-- q2p: comparar el ultimo simbolo, debe ser 1 -->
		<transition><from>4</from><to>5</to><read>1</read><write>X</write><move>L</move></transition>

		<!-- qret: volver al inicio de la cinta -->
		<transition><from>5</from><to>5</to><read>0</read><write>0</write><move>L</move></transition>
		<transition><from>5</from><to>5</to><read>1</read><write>1</write><move>L</move></transition>
		<transition><from>5</from><to>5</to><read>#</read><write>#</write><move>L</move></transition>
		<transition><from>5</from><to>5</to><read>X</read><write>X</write><move>L</move></transition>
		<transition><from>5</from><to>0</to><read></read><write></write><move>R</move></transition>

		<!-- qcheck: ya se consumio toda w de la izquierda, verificar que a la derecha solo queden X -->
		<transition><from>6</from><to>6</to><read>X</read><write>X</write><move>R</move></transition>
		<transition><from>6</from><to>7</to><read></read><write></write><move>R</move></transition>
	</automaton>
</structure>
